[Unit]
Description=Samsung Tizen Dashboard helper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dashboard
WorkingDirectory=/opt/tizen-dashboard/button-redirect
ExecStart=/usr/bin/python3 /opt/tizen-dashboard/button-redirect/watch_buttons.py --config /etc/tizen-dashboard/config.toml --log /var/log/tizen-dashboard/redirect.log
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
